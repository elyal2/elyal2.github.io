      "id": "banco-fraude-ml",
      "title": "Sistema de Detección de Fraude en Tiempo Real con Modelos de Machine Learning",
      "cliente_display": "Entidad Bancaria IBEX",
      "cliente_publico": false,
      "sector": "Banca y Finanzas",
