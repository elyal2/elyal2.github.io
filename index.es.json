      "id": "masorange-aiops",
      "title": "Automatización inteligente de operaciones IT para un operador de telecomunicaciones nacional",
      "cliente_display": "Operador de Telecomunicaciones Nacional",
      "cliente_publico": false,
      "sector": "Telecomunicaciones",
      "tecnologia": [
