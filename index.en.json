    {
      "id": "gestora-activos-inmobiliaria-automatizacion-plusvalias",
      "title": "Automation of Municipal Capital Gains Tax Documentation",
      "cliente_display": "Real Estate Asset Management Company",
      "cliente_publico": false,
      "sector": "Inmobiliario",
      "tecnologia": [
        "AWS",
        "Amazon S3",
        "Amazon SQS",
        "AWS Lambda",
